{
  "name": "bbb-graphql-actions",
  "homepage": "https://github.com/bigbluebutton/bigbluebutton/tree/develop/bbb-graphql-actions#readme",
  "version": "0.0.1",
  "description": "A server component designed to interface between Hasura GraphQL actions and BigBlueButton ecosystem.",
  "main": "index.ts",
  "scripts": {
    "start": "nodemon --watch src --ext ts,json --exec ts-node src/index.ts",
    "build": "tsc",
    "serve": "node dist/index.js",
    "deploy": "tsc && cp dist/index.js /usr/local/bigbluebutton/bbb-graphql-actions/bbb-graphql-actions.js && cp -r dist/actions dist/imports dist/services dist/types dist/websocket /usr/local/bigbluebutton/bbb-graphql-actions/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbluebutton/bigbluebutton/tree/develop/bbb-graphql-actions"
  },
  "keywords": [
    "bigbluebutton",
    "graphql",
    "actions"
  ],
  "author": "BigBlueButton Inc.",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/bigbluebutton/bigbluebutton/issues"
  },
  "dependencies": {
    "@azure/core-auth": "^1.10.1",
    "@types/express": "^4.17.18",
    "@types/node": "^20.7.0",
    "@types/pg": "^8.20.0",
    "@types/redis": "^4.0.11",
    "@types/ws": "^8.5.10",
    "express": "^5.2.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.35.0",
    "pg": "^8.21.0",
    "redis": "^4.7.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
